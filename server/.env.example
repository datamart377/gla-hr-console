# ---- IHRSM API configuration ----
# Copy this file to `.env` and adjust for your environment.

# HTTP
PORT=4000
# Comma-separated list of allowed origins for CORS (the web app dev server).
CORS_ORIGIN=http://localhost:3003

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=gla_hr

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Password applied to every seeded demo account (admin/hr/finance/staff).
SEED_PASSWORD=password

# ---- Outbound email (SMTP) for system notifications ----
# Leave blank to disable email (the app still works; notifications are skipped).
# For a cPanel / shared-host mailbox, use the host's mail server and the mailbox
# password. Port 465 = implicit TLS (secure), 587 = STARTTLS.
SMTP_HOST=mail.glassociates.co.ug
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ehrms@glassociates.co.ug
SMTP_PASS=the-mailbox-password
# Optional display name / from address (defaults to the SMTP_USER).
MAIL_FROM=Global Link Associates HR <ehrms@glassociates.co.ug>
# Public URL used in email links (defaults to Render's service URL).
APP_URL=https://hr.glassociates.co.ug
