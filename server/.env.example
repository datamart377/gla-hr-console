# ---- IHRSM API configuration ----
# Copy this file to `.env` and adjust for your environment.

# HTTP
PORT=4000
# Comma-separated list of allowed origins for CORS (the web app dev server).
CORS_ORIGIN=http://localhost:3003

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=gla_hr

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Password applied to every seeded demo account (admin/hr/finance/staff).
SEED_PASSWORD=password
